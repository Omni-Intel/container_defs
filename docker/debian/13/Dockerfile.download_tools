ARG DENO_VERSION=2.9.7
FROM denoland/deno:bin-${DENO_VERSION} AS deno

FROM debian:13-slim

LABEL maintainer="lapluis"

ENV TZ=Asia/Shanghai
ENV DEBIAN_FRONTEND=noninteractive
ENV DENO_INSTALL_ROOT=/usr/local
ENV DENO_DIR=/opt/deno-cache

ARG OPENNEURO_VERSION=5.6.0

RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends ca-certificates && \
    cp /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list.d/debian.sources.bak && \
    cat <<EOF > /etc/apt/sources.list.d/debian.sources
Types: deb
URIs: https://mirrors.tuna.tsinghua.edu.cn/debian
Suites: trixie trixie-updates trixie-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: https://security.debian.org/debian-security
Suites: trixie-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF

RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends \
    awscli \
    curl \
    wget \
    rsync \
    rclone \
    git \
    datalad \
    git-annex \
    openssh-client && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=deno /deno /usr/local/bin/deno

# Install an executable CLI rather than only adding a project dependency.
RUN deno install --global --allow-all --name openneuro "jsr:@openneuro/cli@${OPENNEURO_VERSION}"

# DataLad and git-annex discover this special remote through PATH.
RUN cat <<'EOF' > /usr/local/bin/git-annex-remote-openneuro
#!/bin/sh
exec openneuro special-remote "$@"
EOF

RUN chmod +x /usr/local/bin/git-annex-remote-openneuro && \
    aws --version && \
    deno --version && \
    openneuro --help && \
    rsync --version && \
    rclone version && \
    git --version && \
    datalad --version && \
    git annex version

WORKDIR /data

CMD ["bash"]
